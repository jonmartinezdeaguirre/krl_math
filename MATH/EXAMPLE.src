&ACCESS RVO
DEF EXAMPLE ( )
   DECL FRAME PROJECTION
   DECL POSE3D_T P_PROJECTION
   
   DECL INT HOME_IDX, STATUS

   ;FOLD PTP $POS_ACT Vel=100 %
      $BWDSTART = FALSE
      PDAT_ACT = PTP_CONFIG
      FDAT_ACT = ROB_CONFIG
      BAS(#PTP_PARAMS, PDAT_ACT.VEL)
      SET_CD_PARAMS (0)
      PTP $POS_ACT
   ;ENDFOLD
   
   HOME_IDX = CREATE_DIALOG("Select HOME position to project current pose onto", "Math Library Example", "HOME[1]", "HOME[2]", "HOME[3]", "HOME[4]", "HOME[5]")

   ; Project the current robot pose onto the plane defined by HOME[HOME_IDX]
   P_PROJECTION = PROJ_P_ACT_ON_HOME_PLANE(HOME_IDX, #PROJ_NORMAL_Z, #PROJ_KEEP_POSE_ROT, STATUS)
   
   IF STATUS <> 0 THEN
      DISPLAY_MESSAGE(#QUIT, "Unable to compute HOME position projection", "Math Library Example")
      RETURN
   ENDIF
   
   ; Convert the projected pose to FRAME for robot motion
   PROJECTION = POSE3D_TO_FRAME(P_PROJECTION)

   ;FOLD LIN PROJECTION Vel=2 m/s
      $BWDSTART = FALSE
      LDAT_ACT = LIN_CONFIG
      FDAT_ACT = ROB_CONFIG
      BAS(#CP_PARAMS, LDAT_ACT.VEL)
      SET_CD_PARAMS (0)
      LIN PROJECTION
   ;ENDFOLD

   ; Move to HOME[HOME_IDX] position in joint coordinates
   PTP $AXIS_HOME[HOME_IDX]
END