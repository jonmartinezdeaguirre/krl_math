DEF EXAMPLE ( )
   DECL FRAME PROJECTION
   DECL POSE3D_T P_PROJECTION
   
   DECL INT HOME_IDX, STATUS

   ;FOLD PTP $POS_ACT Vel=100 %
      $BWDSTART = FALSE
      PDAT_ACT = PTP_CONFIG
      FDAT_ACT = ROB_CONFIG
      BAS(#PTP_PARAMS, PDAT_ACT.VEL)
      SET_CD_PARAMS (0)
      PTP $POS_ACT
   ;ENDFOLD
   
   HOME_IDX = CREATE_DLG("Select HOME position to project current pose onto", "Math Library Example", "HOME[1]", "HOME[2]", "HOME[3]", "HOME[4]", "HOME[5]")

   ; Project the current robot pose onto the plane defined by HOME[HOME_IDX]
   P_PROJECTION = PROJ_P_ACT_ON_HOME_PLANE(HOME_IDX, #PROJ_NORMAL_Z, #PROJ_KEEP_POSE_ROT, STATUS)
   
   IF STATUS <> 0 THEN
      DISPLAY_MSG(#QUIT, "Unable to compute HOME position projection", "Math Library Example")
      RETURN
   ENDIF
   
   ; Convert the projected pose to FRAME for robot motion
   PROJECTION = POSE3D_TO_FRAME(P_PROJECTION)

   ;FOLD LIN PROJECTION Vel=2 m/s
      $BWDSTART = FALSE
      LDAT_ACT = LIN_CONFIG
      FDAT_ACT = ROB_CONFIG
      BAS(#CP_PARAMS, LDAT_ACT.VEL)
      SET_CD_PARAMS (0)
      LIN PROJECTION
   ;ENDFOLD

   ; Move to HOME[HOME_IDX] position in joint coordinates
   PTP $AXIS_HOME[HOME_IDX]
END

DEF DISPLAY_MSG ( MSG_TYPE: IN, CUSTOM_MSG: IN, MODULE: IN )
   CHAR CUSTOM_MSG[]
   CHAR MODULE[]
   BOOL MSG_EXISTS, MSG_CLEARED
   
   DECL EKRLMSGTYPE MSG_TYPE
   DECL KRLMSG_T MSG
   DECL KRLMSGPAR_T MSG_PARAMS[3]
   DECL KRLMSGOPT_T MSG_OPT
   
   IF (VARSTATE("LAST_MESSAGE_HANDLE") == #INITIALIZED) THEN
      MSG_CLEARED = FALSE
      
      REPEAT
         MSG_EXISTS = EXISTS_KRLMSG(LAST_MESSAGE_HANDLE)
         MSG_CLEARED = CLEAR_KRLMSG(LAST_MESSAGE_HANDLE)
      UNTIL NOT(MSG_EXISTS) OR MSG_CLEARED
   ENDIF
   
   IF (VARSTATE("MODULE") == #DECLARED) THEN
      MODULE[] = "KUKA"
   ENDIF
   
   MSG.MSG_TXT[] = CUSTOM_MSG[]
   MSG.MODUL[] = MODULE[]
   MSG.NR = 1
   
   MSG_OPT = {VL_STOP TRUE, CLEAR_P_RESET TRUE, CLEAR_P_SAW FALSE, LOG_TO_DB FALSE}
   
   LAST_MESSAGE_HANDLE = SET_KRLMSG(MSG_TYPE, MSG, MSG_PARAMS[], MSG_OPT)
END

DEFFCT INT CREATE_DLG ( CUSTOM_MSG: IN, MODULE: IN, BTN_1: IN, BTN_2: IN, BTN_3: IN, BTN_4: IN, BTN_5: IN, BTN_6: IN, BTN_7: IN )
   CHAR CUSTOM_MSG[]
   CHAR MODULE[]
   CHAR BTN_1[]
   CHAR BTN_2[]
   CHAR BTN_3[]
   CHAR BTN_4[]
   CHAR BTN_5[]
   CHAR BTN_6[]
   CHAR BTN_7[]
        
   INT DLG_HANDLE, DLG_ANSWER
   BOOL DLG_EXISTS
   
   DECL KRLMSG_T DLG_MSG
   DECL KRLMSGPAR_T DLG_PARAMS[3]
   DECL KRLMSGDLGSK_T DLG_BTNS[7]
   DECL KRLMSGOPT_T DLG_OPT
   
   DLG_ANSWER = 0
   
   DLG_MSG.MSG_TXT[] = CUSTOM_MSG[]
   DLG_MSG.MODUL[] = MODULE[]
   DLG_MSG.NR = 1
   
   DLG_PARAMS[1] = {PAR_TYPE #EMPTY}
   DLG_PARAMS[2] = {PAR_TYPE #EMPTY}
   DLG_PARAMS[3] = {PAR_TYPE #EMPTY}
   
   IF (VARSTATE("MODULE") == #DECLARED) THEN
      MODULE[] = "KUKA"
   ENDIF
   
   IF (VARSTATE("BTN_1[]") == #INITIALIZED) THEN
      DLG_BTNS[1] = SET_DLG_BTN(BTN_1[])
   ELSE
      DLG_BTNS[1] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_2[]") == #INITIALIZED) THEN
      DLG_BTNS[2] = SET_DLG_BTN(BTN_2[])
   ELSE
      DLG_BTNS[2] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_3[]") == #INITIALIZED) THEN
      DLG_BTNS[3] = SET_DLG_BTN(BTN_3[])
   ELSE
      DLG_BTNS[3] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_4[]") == #INITIALIZED) THEN
      DLG_BTNS[4] = SET_DLG_BTN(BTN_4[])
   ELSE
      DLG_BTNS[4] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_5[]") == #INITIALIZED) THEN
      DLG_BTNS[5] = SET_DLG_BTN(BTN_5[])
   ELSE
      DLG_BTNS[5] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_6[]") == #INITIALIZED) THEN
      DLG_BTNS[6] = SET_DLG_BTN(BTN_6[])
   ELSE
      DLG_BTNS[6] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   IF (VARSTATE("BTN_7[]") == #INITIALIZED) THEN
      DLG_BTNS[7] = SET_DLG_BTN(BTN_7[])
   ELSE
      DLG_BTNS[7] = SET_EMPTY_DLG_BTN()
   ENDIF
   
   DLG_OPT = {VL_STOP TRUE, CLEAR_P_RESET TRUE, CLEAR_P_SAW FALSE, LOG_TO_DB FALSE}
   
   DLG_HANDLE = SET_KRLDLG(DLG_MSG, DLG_PARAMS[], DLG_BTNS[], DLG_OPT)
   
   REPEAT
      DLG_EXISTS = EXISTS_KRLDLG(DLG_HANDLE, DLG_ANSWER)
   UNTIL NOT(DLG_EXISTS)
   
   RETURN DLG_ANSWER
ENDFCT

DEFFCT KRLMSGDLGSK_T SET_DLG_BTN ( BTN_TEXT: IN )
   CHAR BTN_TEXT[]
   DECL KRLMSGDLGSK_T BUTTON
   
   BUTTON.SK_TYPE = #VALUE
   BUTTON.SK_TXT[] = BTN_TEXT[]
      
   RETURN BUTTON
ENDFCT

DEFFCT KRLMSGDLGSK_T SET_EMPTY_DLG_BTN ( )
   RETURN {SK_TYPE #EMPTY}
ENDFCT